    ".": "./index.js",
    "./client": "./client.js",
    "./lib/guard.mjs": "./lib/guard.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "upgrade",
    "compatibility",
    "smoke-test"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wqx11235/dsh-upgrade-guard.git"
  },
